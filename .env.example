# Copia este archivo a .env (NO lo subas a git) y cambia los valores.
# Genera la clave con:  python -c "import secrets; print(secrets.token_hex(32))"
AP_SECRET_KEY=
APP_ENV=development
# Producción: orígenes permitidos del frontend, separados por coma
AP_CORS_ORIGINS=
POSTGRES_PASSWORD=cambia-esto
MINIO_ROOT_PASSWORD=cambia-esto-tambien
